// Zolee Energy Flow Display - Loxone Pico C MQTT payload builder
//
// Program block mapping:
// I1  PowerGrid          [kW]  positive=import, negative=export
// I2  PowerBat           [kW]  positive=discharge, negative=charge
// I3  PowerPV            [kW]
// I4  SocBat             [%]
// I5  PowerFull          [kW]
// I6  Temperature        [C]
// I7  WindSpeed          [km/h]
// I8  HasSunRadiation    [0/1]
// I9  HasPrecipitation   [0/1]
// I10 Status             [1..4]
// I11 NightMode          [0/1]
// I12 BatteryTemperature [C]
//
// Txt1: one complete JSON document every 5 seconds.
//
// IMPORTANT: PicoC does not reliably support adjacent C string literal
// concatenation. Keep the complete JSON format as ONE string literal in
// sprintf(), otherwise the interpreter can stop at the second string fragment.

#define UPDATE_INTERVAL_MS 5000
#define JSON_BUFFER_SIZE 512

char json[JSON_BUFFER_SIZE];

while (TRUE)
{
    float powerGrid = getinput(0);
    float powerBat = getinput(1);
    float powerPV = getinput(2);
    float socBat = getinput(3);
    float powerFull = getinput(4);
    float temperature = getinput(5);
    float windSpeed = getinput(6);
    float hasSunRadiation = getinput(7);
    float hasPrecipitation = getinput(8);
    float status = getinput(9);
    float nightMode = getinput(10);
    float batteryTemperature = getinput(11);

    sprintf(
        json,
        "{\"PowerGrid\":%f,\"PowerBat\":%f,\"PowerPV\":%f,\"SocBat\":%f,\"PowerFull\":%f,\"Temperature\":%f,\"WindSpeed\":%f,\"HasSunRadiation\":%f,\"HasPrecipitation\":%f,\"Status\":%f,\"NightMode\":%f,\"BatteryTemperature\":%f}",
        powerGrid,
        powerBat,
        powerPV,
        socBat,
        powerFull,
        temperature,
        windSpeed,
        hasSunRadiation,
        hasPrecipitation,
        status,
        nightMode,
        batteryTemperature
    );

    setoutputtext(0, json);
    sleep(UPDATE_INTERVAL_MS);
}
