// Zolee Energy Flow Display - Loxone Pico C MQTT adatcsomag-összeállító
//
// Program blokk bemenetek:
// I1  PowerGrid          [kW]  pozitív=vétel, negatív=visszatáplálás
// I2  PowerBat           [kW]  pozitív=kisütés, negatív=töltés
// I3  PowerPV            [kW]  pillanatnyi PV termelés
// I4  SocBat             [%]   akkumulátor töltöttség
// I5  PowerFull          [kW]  ház pillanatnyi fogyasztása
// I6  Temperature        [C]   külső hőmérséklet
// I7  WindSpeed          [km/h]
// I8  HasSunRadiation    [0/1]
// I9  HasPrecipitation   [0/1]
// I10 Status             [1..4]
// I11 NightMode          [0/1]
// I12 BatteryTemperature [C]
// I13 WeatherPresent     [0..15] jelenlétmaszk: I6=1, I7=2, I8=4, I9=8
// A nem használt időjárásbemenet bitje 0; minden bekötve: 15.
// Pico C nem jelzi a bekötöttséget: a maszkot a Configban kell beállítani.
// Bekötetlen I13 (0): mind a négy időjárási mező null.
//
// Txt1 kimenet: 5 másodpercenként egy teljes JSON dokumentum.
//
// FONTOS: a Loxone Pico C értelmező nem kezeli megbízhatóan az egymás mellé
// írt C string literálok automatikus összefűzését. A teljes JSON formátum
// ezért egyetlen string literál marad az sprintf() hívásban.

#define UPDATE_INTERVAL_MS 5000
#define JSON_BUFFER_SIZE 512

// A teljes MQTT JSON csomag közös munkapuffere.
char json[JSON_BUFFER_SIZE];

// A Program blokk folyamatosan fut; minden ciklus egy új állapotcsomagot készít.
while (TRUE)
{
    // Az összes Loxone bemenet pillanatnyi értékének kiolvasása.
    float powerGrid = getinput(0);
    float powerBat = getinput(1);
    float powerPV = getinput(2);
    float socBat = getinput(3);
    float powerFull = getinput(4);
    float temperature = getinput(5);
    float windSpeed = getinput(6);
    float hasSunRadiation = getinput(7);
    float hasPrecipitation = getinput(8);
    float status = getinput(9);
    float nightMode = getinput(10);
    float batteryTemperature = getinput(11);
    float weatherPresentInput = getinput(12);
    int weatherPresent = 0;
    if (weatherPresentInput >= 0 && weatherPresentInput <= 15)
    {
        weatherPresent = weatherPresentInput;
        if (weatherPresentInput != weatherPresent) weatherPresent = 0;
    }
    char temperatureJson[64];
    char windJson[64];
    char sunJson[64];
    char precipitationJson[64];
    sprintf(temperatureJson, "null");
    sprintf(windJson, "null");
    sprintf(sunJson, "null");
    sprintf(precipitationJson, "null");
    if (weatherPresent & 1) sprintf(temperatureJson, "%f", temperature);
    if (weatherPresent & 2) sprintf(windJson, "%f", windSpeed);
    if (weatherPresent & 4) sprintf(sunJson, "%f", hasSunRadiation);
    if (weatherPresent & 8) sprintf(precipitationJson, "%f", hasPrecipitation);

    // A firmware által elvárt 12 kötelező mezőből egyetlen JSON objektum készül.
    sprintf(
        json,
        "{\"PowerGrid\":%f,\"PowerBat\":%f,\"PowerPV\":%f,\"SocBat\":%f,\"PowerFull\":%f,\"Temperature\":%s,\"WindSpeed\":%s,\"HasSunRadiation\":%s,\"HasPrecipitation\":%s,\"Status\":%f,\"NightMode\":%f,\"BatteryTemperature\":%f}",
        powerGrid,
        powerBat,
        powerPV,
        socBat,
        powerFull,
        temperatureJson,
        windJson,
        sunJson,
        precipitationJson,
        status,
        nightMode,
        batteryTemperature
    );

    // A teljes JSON a Program blokk első szöveges kimenetére kerül.
    setoutputtext(0, json);

    // A specifikáció szerinti 5 másodperces publikálási periódus.
    sleep(UPDATE_INTERVAL_MS);
}

