# Only the build copy changes; upstream DMA buffers and managed sources stay intact.
idf_component_get_property(hosted_dir espressif__esp_hosted COMPONENT_DIR)
idf_component_get_property(hosted_lib espressif__esp_hosted COMPONENT_LIB)
idf_build_get_property(hosted_patch_python PYTHON)
get_target_property(hosted_sources ${hosted_lib} SOURCES)
set(hosted_fixed_sources "")
set(hosted_patch_count 0)
foreach(hosted_source IN LISTS hosted_sources)
    if(hosted_source MATCHES "(^|/)sdio_drv\\.c$")
        if(IS_ABSOLUTE "${hosted_source}")
            set(hosted_original "${hosted_source}")
        else()
            set(hosted_original "${hosted_dir}/${hosted_source}")
        endif()
        set(hosted_script "${CMAKE_CURRENT_LIST_DIR}/../tools/patch_hosted_rx.py")
        set(hosted_fixed "${CMAKE_BINARY_DIR}/hosted-rx/sdio_drv.c")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${hosted_original}" "${hosted_script}")
        execute_process(COMMAND "${hosted_patch_python}" "${hosted_script}"
            --input "${hosted_original}" --output "${hosted_fixed}"
            RESULT_VARIABLE hosted_patch_result)
        if(NOT hosted_patch_result EQUAL 0)
            message(FATAL_ERROR "ESP-Hosted RX patch failed")
        endif()
        get_filename_component(hosted_original_dir "${hosted_original}" DIRECTORY)
        target_include_directories(${hosted_lib} PRIVATE "${hosted_original_dir}")
        list(APPEND hosted_fixed_sources "${hosted_fixed}")
        math(EXPR hosted_patch_count "${hosted_patch_count}+1")
    else()
        list(APPEND hosted_fixed_sources "${hosted_source}")
    endif()
endforeach()
if(NOT hosted_patch_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one ESP-Hosted SDIO driver")
endif()
set_property(TARGET ${hosted_lib} PROPERTY SOURCES ${hosted_fixed_sources})
