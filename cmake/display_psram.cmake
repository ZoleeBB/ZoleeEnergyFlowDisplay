# Az adapter részleges pufferfoglalása a profile->use_psram értéket kövesse.
# Csak buildbeli másolatot fordítunk: a managed component eredetije érintetlen.
idf_component_get_property(display_adapter_dir espressif__esp_lvgl_adapter COMPONENT_DIR)
idf_component_get_property(display_adapter_lib espressif__esp_lvgl_adapter COMPONENT_LIB)
idf_build_get_property(display_patch_python PYTHON)
get_target_property(display_adapter_sources ${display_adapter_lib} SOURCES)
set(display_adapter_fixed_sources "")
set(display_adapter_patch_count 0)
foreach(adapter_source IN LISTS display_adapter_sources)
    if(adapter_source MATCHES "(^|/)(display_manager|lvgl_bridge_v9)\\.c$")
        if(IS_ABSOLUTE "${adapter_source}")
            set(adapter_original "${adapter_source}")
        else()
            set(adapter_original "${display_adapter_dir}/${adapter_source}")
        endif()
        get_filename_component(adapter_name "${adapter_source}" NAME)
        set(adapter_fixed "${CMAKE_BINARY_DIR}/display-psram/${adapter_name}")
        if(adapter_name STREQUAL "display_manager.c")
            set(adapter_patch_script "${CMAKE_CURRENT_LIST_DIR}/../tools/patch_display_adapter.py")
        else()
            set(adapter_patch_script "${CMAKE_CURRENT_LIST_DIR}/../tools/patch_display_rotation.py")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${adapter_original}" "${adapter_patch_script}")
        execute_process(COMMAND "${display_patch_python}" "${adapter_patch_script}"
            --input "${adapter_original}" --output "${adapter_fixed}"
            RESULT_VARIABLE adapter_patch_result)
        if(NOT adapter_patch_result EQUAL 0)
            message(FATAL_ERROR "Display adapter patch failed: ${adapter_name}")
        endif()
        get_filename_component(adapter_original_dir "${adapter_original}" DIRECTORY)
        target_include_directories(${display_adapter_lib} PRIVATE "${adapter_original_dir}")
        list(APPEND display_adapter_fixed_sources "${adapter_fixed}")
        math(EXPR display_adapter_patch_count "${display_adapter_patch_count}+1")
    else()
        list(APPEND display_adapter_fixed_sources "${adapter_source}")
    endif()
endforeach()
if(NOT display_adapter_patch_count EQUAL 2)
    message(FATAL_ERROR "Expected display_manager.c and lvgl_bridge_v9.c in the LVGL adapter")
endif()
set_property(TARGET ${display_adapter_lib} PROPERTY SOURCES ${display_adapter_fixed_sources})
