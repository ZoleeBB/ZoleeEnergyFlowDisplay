CONFIG_IDF_TARGET="esp32p4"
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Generic UI/JSON/zlib allocations prefer PSRAM; protect internal DMA memory.
# 32 KiB boots on this board; 64 KiB fails before app_main (ESP_ERR_NO_MEM).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
# A hiányzó/hibás hangkodek visszatérési hibát adjon, ne abortálja a kijelzőt.
# CONFIG_BSP_ERROR_CHECK is not set
CONFIG_BSP_LCD_TYPE_800_1280_10_1_INCH=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_BSP_SD_MOUNT_POINT="/sdcard"
# CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL is not set
# Az adapter saját FreeRTOS taskja és recursive mutexe sorosítja az LVGL-t.
# A rajzolás ne használjon külön OSAL/task-notification alapú worker szálakat.
CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
CONFIG_LV_USE_CHART=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_FS_LOCK=4

# 10 nap: hosszabb az alkalmazás legfeljebb 7 napos kézi periódusánál,
# de kisebb az lwIP sys_timeout UINT32_MAX/4 (~12,4 nap) korlátjánál.
# A korábbi 14 nap SNTP induláskor/szinkronkor assertet és rebootot okozott.
# A web, Loxone WS, MJPEG, mDNS és a külön SIP/RTP socketek közös kerete.
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_SNTP_UPDATE_DELAY=864000000

# A korábbi vektoros rajzolási konfiguráció kompatibilitásból megmarad.
# A ThorVG adja az LVGL szoftveres SVG/vector renderelését.
CONFIG_LV_USE_VECTOR_GRAPHIC=y
CONFIG_LV_USE_MATRIX=y
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_THORVG=y
CONFIG_LV_USE_THORVG_INTERNAL=y
CONFIG_LV_USE_SVG=y

# A soros vektoros/PNG renderelés 32 KiB-os adapter stackjét az app_ui állítja.

# A dekódolt képek újrafelhasználásához képcache-t tartunk fenn.
CONFIG_LV_CACHE_DEF_SIZE=10485760


# Az önállóan újraalkotott, átlátszó PNG assetek dekódere.
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_SNAPSHOT=y



# Signed chart: opaque -> transparent zero -> opaque.
CONFIG_LV_GRADIENT_MAX_STOPS=3

# Bounded transport backlog for 5-second energy samples and local web UI.
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=8
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=8

# P4: a NimBLE host a C6 vezérlőjét használja a meglévő SDIO kapcsolaton.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_NIMBLE_TRANSPORT_UART is not set
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# A host dinamikus pufferei PSRAM-ból foglalódnak.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# Az ESP-Hosted 1.4.7 a hagyományos NimBLE mempool API-t használja.
# CONFIG_BT_NIMBLE_MEMPOOL_RUNTIME_ALLOC is not set

# Valós, magonkénti diagnosztikai CPU-terhelés az idle futásidőből.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# A GitHub API és release-letöltés mindig ellenőrzött HTTPS kapcsolat.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Wi-Fi-profil kizárólag MITM-hitelesített LE Secure Connections kapcsolaton.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
# CONFIG_BT_NIMBLE_SM_LEGACY is not set
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
# CONFIG_BT_NIMBLE_SM_SC_DEBUG_KEYS is not set
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# CONFIG_BT_NIMBLE_HANDLE_REPEAT_PAIRING_DELETION is not set

# A TLS nagy pufferei ne a kijelző/Wi-Fi/DMA szűk belső RAM-ját fogyasszák.
# Mindkét célhardveren van PSRAM; a tanúsítvány-ellenőrzés változatlan.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
